# Configuración de Base de Datos (SQLite por defecto o PostgreSQL)
DATABASE_URL=sqlite:///./pokemon.db
# Para conectar a PostgreSQL en Docker Compose usa:
# DATABASE_URL=postgresql+psycopg2://pokemon_user:pokemon_pass@postgres:5432/pokemon_db

# Configuración de PostgreSQL (Docker)
POSTGRES_USER=pokemon_user
POSTGRES_PASSWORD=pokemon_pass
POSTGRES_DB=pokemon_db

# Configuración de pgAdmin (Docker)
PGADMIN_DEFAULT_EMAIL=admin@pokemon.local
PGADMIN_DEFAULT_PASSWORD=admin123
