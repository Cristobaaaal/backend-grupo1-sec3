# Configuración de Base de Datos (solo para ejecutar sin Docker)
# Con Docker no se usa: docker-compose arma la URL con las variables POSTGRES_*.
DATABASE_URL=sqlite:///./pokemon.db

# Configuración de PostgreSQL (Docker)
POSTGRES_USER=pokemon_user
POSTGRES_PASSWORD=pokemon_pass
POSTGRES_DB=pokemon_db

# Configuración de pgAdmin (Docker)
PGADMIN_DEFAULT_EMAIL=admin@pokemon.com
PGADMIN_DEFAULT_PASSWORD=admin123

# Configuración de Autenticación y Seguridad (JWT)
JWT_SECRET=cambia_esto_por_un_secreto_seguro
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Configuración de Correo Electrónico (SMTP)
# Correo de prueba con Mailpit: no envía correos reales.
# Bandeja web para ver los correos: http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
